<div class="modal fade" tabindex="-1" role="dialog" id="tax_record" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-bind="html:(model.lang() != undefined) ? model.lang().add_new_record : ''">Add New Record</h5>
            </div>
            <div class="modal-body" style="padding:25px">
                <div class="form-horizontal" id="form_tax">
                    <div class="form-group">
                        <label for="inputEmail3" class="col-sm-2 control-label" data-bind="html:(model.lang() != undefined) ? model.lang().jurisdiction_res : ''">Jurisdiction of Residence</label>
                        <div class="col-sm-10">
                            <select type="text" class="form-control" name="jurisdiction" id="jurisdiction" required data-bind="value: tax.jurisdiction,attr: { validationMessage : (model.lang() != undefined)? model.lang().compuls_qu() : ''}" style="width:100%;"></select>
                            <span class="k-invalid-msg" data-for="jurisdiction"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="inputPassword3" class="col-sm-2 control-label" data-bind="html: (model.lang() != undefined) ? model.lang().tin : ''">TIN</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" id="tin_" name="tin_" placeholder="TIN" required data-bind="value: tax.tin, attr: { validationMessage : (model.lang() != undefined)? model.lang().compuls_qu() : ''}">
                            <span class="k-invalid-msg" data-for="tin_"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="inputPassword3" class="col-sm-2 control-label" data-bind="html: (model.lang() != undefined) ? model.lang().No_tin_reason : ''">No TIN Reason</label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" id="no_tin" placeholder="No TIN Reason" data-bind="value: tax.tin_reason">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="add_row_tax()" data-bind="visible: tax.edit() == false">Add</button>
                <button type="button" class="btn btn-warning" onclick="add_row_tax()" data-bind="visible: tax.edit() == true">Update</button>
            </div>
        </div>
    </div>
</div>
<iframe id="download_frame" style="display:none;"></iframe>





